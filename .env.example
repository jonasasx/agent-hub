# Agent Hub — hub configuration. Copy to .env in the repository root (chmod 600) and fill in.
# Never commit the filled file.

# ---------- hub ----------
# Public address of the hub (browsers, desktop app and agents connect here).
PUBLIC_URL=https://hub.example.com
# More addresses of the same hub, comma-separated (each needs its own OIDC redirect URIs)
EXTRA_PUBLIC_URLS=
PORT=8080
DATABASE_URL=postgres://agenthub:change-me@db:5432/agenthub
# 32+ random characters: openssl rand -base64 48
COOKIE_SECRET=change-me-change-me-change-me-change-me
# Sign-in, one of two modes (setting both is a startup error).
# Mode 1 — one OIDC provider (Keycloak with its own registration, it brokers Google and other providers):
# client redirect URIs <PUBLIC_URL>/auth/callback and <PUBLIC_URL>/auth/desktop/callback, post-logout redirect URI <PUBLIC_URL>/
# for every address of PUBLIC_URL and EXTRA_PUBLIC_URLS.
# OIDC_ISSUER=https://id.example.com/realms/agent-hub
# OIDC_CLIENT_ID=agent-hub
# OIDC_CLIENT_SECRET=change-me
# Text of the main sign-in button (default OIDC).
# OIDC_PROVIDER_LABEL=Agent Hub ID
# Extra buttons that go straight to a broker of the provider (kc_idp_hint): alias:Label@https://address, comma-separated;
# @address limits the button to that public address.
# OIDC_IDP_HINTS=corp:Corporate SSO@https://hub.example.com
# «Manage sign-in» link in Settings → Security; default <OIDC_ISSUER>/account for a Keycloak realm.
# OIDC_ACCOUNT_URL=
# invite — only invited addresses and existing users; open — any verified address gets an account.
# SIGNUP_MODE=invite
# Mode 2 — Google and an optional second provider directly (comment out when using mode 1).
# Google: an OAuth client of type «Web application», redirect URIs <PUBLIC_URL>/auth/callback and <PUBLIC_URL>/auth/desktop/callback
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
OIDC_GOOGLE_CLIENT_SECRET=change-me
# Optional second provider (Keycloak or any OIDC issuer); empty id or secret — off.
OIDC_KEYCLOAK_ISSUER=
OIDC_KEYCLOAK_CLIENT_ID=
OIDC_KEYCLOAK_CLIENT_SECRET=
# Text of the second provider's button (default Keycloak).
OIDC_KEYCLOAK_LABEL=
# Public URLs offering Keycloak, comma-separated; empty means all public addresses.
OIDC_KEYCLOAK_PUBLIC_URLS=
# Bootstrap administrators; everyone else enters by invite. On a PaaS that reserves the OIDC_ prefix — HUB_ADMIN_EMAILS.
OIDC_ALLOWED_EMAILS=you@example.com
# X-Forwarded-For is trusted only from these proxies (your TLS reverse proxy), comma-separated addresses or CIDRs.
# Behind a relay reverse proxy add its address here, otherwise every client gets the relay IP (shared rate limits).
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
LOG_LEVEL=info

# ---------- hosted compose (deploy/compose.yml) ----------
# Private addresses the hub (8090) and Keycloak (8091) ports bind to, reached by the relay reverse proxy.
HUB_BIND_ADDR=10.0.0.3
KEYCLOAK_BIND_ADDR=10.0.0.3
# Host names routed by Traefik: the old agent address (redirects browsers to HUB_HOST_PUBLIC) and the Keycloak admin console.
HUB_HOST_LAN=hub.lan.example.com
HUB_HOST_PUBLIC=hub.example.com
KEYCLOAK_ADMIN_HOST=id.lan.example.com
# Existing Docker network of the Traefik instance.
PROXY_NETWORK=traefik_default

# ---------- storage ----------
# S3 bucket for raw transcripts and blobs (required in production).
# A PaaS may provide S3_BUCKET and S3_REGION instead: they are used when S3_BUCKET_DATA / AWS_REGION are unset (an empty value counts as unset).
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_DATA=
S3_PREFIX=
# S3-compatible storage (MinIO, Ceph RGW and others): endpoint, path-style addressing and static keys (both or neither). Empty — AWS, keys from AWS_*.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The disk free-space monitor reads this mount; without it (a container without a data volume) the monitor is off.
DATA_VOLUME_PATH=/hostdata
DISK_ALERT_FREE_PCT=15
ALERT_HOST_LABEL=hub

# ---------- sessions ----------
IDLE_TIMEOUT_MIN=30
PERMISSION_IDLE_TIMEOUT_MIN=120
EXTERNAL_WRITE_GUARD_MIN=10
HANDOFF_MODEL=sonnet

# ---------- subscriptions ----------
# AES-256-GCM key for Claude/Codex subscription credentials stored in Postgres: openssl rand -base64 32
# Empty — the registry is read-only, sessions run under each machine's own login.
# A new key makes stored tokens unreadable: re-add every subscription afterwards.
SUBSCRIPTION_TOKEN_KEY=
SUBSCRIPTION_CONNECTORS_HINT=true
LIMITS_PROBE_LAST_HOSTS=

# ---------- notifications (optional) ----------
# Web push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Operational alerts (disk space, backups) to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# GET /metrics with Authorization: Bearer <METRICS_TOKEN>; empty — 404.
METRICS_TOKEN=

# ---------- voice input (optional) ----------
# ElevenLabs key; empty — dictation is off.
ELEVENLABS_API_KEY=
# VOICE_LANGUAGE=en
# Voice conversation: the ElevenLabs agent whose Custom LLM is <PUBLIC_URL>/voice-llm/v1 and the key of that
# endpoint (≥32 characters, the agent's Custom LLM secret). Either empty — the conversation is off.
VOICE_AGENT_ID=
VOICE_LLM_KEY=
# Key with ElevenAgents access for the agent's signed URLs; empty — ELEVENLABS_API_KEY is used.
VOICE_AGENT_API_KEY=
# Below ~45 s: ElevenLabs ends the conversation when a Custom LLM response takes longer.
# VOICE_TURN_MAX_MS=35000

# ---------- desktop app updates (optional) ----------
DESKTOP_UPDATES_DIR=

# ---------- db (postgres:17) ----------
POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
POSTGRES_PASSWORD=change-me

# ---------- backup (optional) ----------
# deploy/backup.sh copies every daily dump to this bucket under S3_BACKUP_PREFIX with the AWS_* keys above (put-only rights,
# see deploy/README.md). Empty — dumps stay on the machine only.
S3_BUCKET_BACKUPS=
S3_BACKUP_PREFIX=pg/
